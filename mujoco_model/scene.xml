<mujoco model="ur10e scene">
  <statistic center="0.3 0 0.4" extent="1.8"/>
  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <global offwidth="640" offheight="480"/>
  </visual>

  <!-- Inclure le robot UR10e au niveau racine -->
  <include file="ur10e.xml"/>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="512"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <worldbody>
    <!-- Sol -->
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>
    
    <!-- Éclairage -->
    <light pos="0 0 3" dir="0 0 -1" directional="true"/>

    <!-- Caméra zénithale -->
    <camera name="overhead_cam" pos="0.5 0.0 1.5" mode="fixed" xyaxes="1 0 0 0 1 0" fovy="60"/>

    <!-- 1. CIBLE : Balle ROUGE (Doit être DÉTECTÉE) -->
    <body name="target_red_ball" pos="0.5 -0.24 0.9">
      <geom name="target_geom" type="sphere" size="0.04" rgba="1 0 0 1" contype="0" conaffinity="0"/>
    </body>

    <!-- 2. PIÈGE 1 : Cube ROUGE (Même couleur, mauvaise forme -> Doit être IGNORÉ) -->
    <body name="distractor_red_cube" pos="0.75 -0.24 0.9">
      <geom name="cube_geom" type="box" size="0.04 0.04 0.04" rgba="1 0 0 1" contype="0" conaffinity="0"/>
    </body>

    <!-- 3. PIÈGE 2 : Balle VERTE (Bonne forme, mauvaise couleur -> Doit être IGNORÉE) -->
    <body name="distractor_green_ball" pos="0.25 -0.24 0.9">
      <geom name="green_ball_geom" type="sphere" size="0.04" rgba="0 1 0 1" contype="0" conaffinity="0"/>
    </body>
  </worldbody>
</mujoco>
